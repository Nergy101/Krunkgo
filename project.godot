; Engine configuration file.
; BLOCKSHOT - single-player voxel arena FPS. Bar: Krunker.io
;
; Scenes are built in code (scripts/main.gd) on purpose: parallel agents edit
; GDScript cleanly and .tscn files badly. Only main.tscn exists on disk.

config_version=5

[application]

config/name="BLOCKSHOT"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Tuning="*res://scripts/tuning.gd"
Game="*res://scripts/game.gd"
Audio="*res://scripts/audio.gd"
Harness="*res://scripts/harness.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="actor"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="projectile"
3d_render/layer_1="world"
3d_render/layer_2="viewmodel"

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.1

[physics]

common/physics_ticks_per_second=120
common/physics_jitter_fix=0.0
3d/default_gravity=24.0

[rendering]

;  Required for the universal/arm64 macOS export preset; without it
;  --export-release refuses to run. NOTE: project.godot comments must start
;  with ';' - a '#' line is not a comment here and silently voided this key,
;  so the setting read back as false while the file plainly said true.
textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.53, 0.71, 0.91, 1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
